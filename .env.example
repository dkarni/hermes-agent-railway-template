# Web server
PORT=8080

# Admin panel credentials
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# All other Hermes configuration (LLM providers, messaging channels, tool API keys)
# is managed through the web UI at /

# --- Polymarket research (paper trading only) --------------------------------
# The worker boots with zero changes; all vars below are optional overrides.
# TRADING_MODE must be "paper" (anything else refuses to start).
TRADING_MODE=paper
# Set POLYMARKET_ENABLED=0 to disable the worker entirely.
POLYMARKET_ENABLED=1
# Persistent DB dir (Railway volume). Local dev: ./local-data/polymarket
# POLY_DATA_DIR=/data/polymarket
# POLY_PORT=8700
# REPORT_TIMEZONE=Europe/Madrid
# DAILY_REPORT_TIME=21:00
# RULE_UPDATE_ENABLED=true
# DEMO_MODE=false
# The dedicated "polymarket" Hermes profile (its own Telegram bot + LLM engine)
# is configured by the owner on the volume; bootstrap_poly.py only adds the MCP.
